# Copie para .env (na raiz do projeto) e preencha. O .env fica fora do git: nunca suba ele.
# O "docker compose --profile app up -d --build" le este arquivo sozinho e passa os valores pros containers.
# Onde pegar cada chave: README, secao "Rodar tudo no Docker".

# --- Porta do site no seu computador (ou no servidor) ---
APP_PORT=8080
# endereco do site: quem pode chamar a API e abrir os WebSockets. Em producao, o seu dominio com https
ALLOWED_ORIGINS=http://localhost:8080

# --- Banco (PostgreSQL). A senha vale pro container do banco e pro backend/worker ---
DATABASE_NAME=vanroute_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=troque-por-uma-senha-forte

# --- Arquivos (MinIO). Usuario e senha do MinIO e do backend ---
MINIO_ACCESS_KEY=vanroute
MINIO_SECRET_KEY=troque-por-uma-senha-forte
MINIO_BUCKET_NAME=vanroute-storage

# --- Login (JWT): texto aleatorio com 32 caracteres ou mais. Sem ele o backend nao sobe.
# Gerar: openssl rand -base64 48   (trocar invalida todos os logins)
JWT_KEY=

# --- E-mail que manda os codigos de verificacao (Gmail: senha de app, nao a senha da conta) ---
SENDER_EMAIL=
SENDER_PASSWORD=

# --- Mapas (OpenRouteService): endereco -> coordenada, trajeto e tempo da van ---
ORS_API_KEY=

# --- Worker: horario das tarefas diarias (Sao Paulo) ---
WORKER_RUN_AT=00:05
