# Variaveis do servidor (producao). Copie para .env NO SERVIDOR (o .env fica fora do git) e preencha.
# O docker compose le o .env sozinho e passa pros containers. Na sua maquina de desenvolvimento nada disso
# e necessario: o backend usa os padroes (localhost) + o backend/src/main/resources/application-local.properties.

# --- Banco (PostgreSQL) ---
DATABASE_HOST=endereco-do-banco
DATABASE_PORT=5432
DATABASE_NAME=vanroute_db
DATABASE_USERNAME=vanroute
DATABASE_PASSWORD=troque-por-uma-senha-forte

# --- Login (JWT): texto aleatorio com 32+ caracteres. Trocar invalida todos os logins ---
JWT_KEY=troque-por-um-texto-aleatorio-longo
# validade do token (ms): 15 min / refresh 30 dias
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# --- Redis (codigos de e-mail, refresh token, chat em tempo real) ---
REDIS_HOST=endereco-do-redis
REDIS_PORT=6379

# --- Arquivos (MinIO ou outro S3) ---
MINIO_ENDPOINT=https://arquivos.seu-dominio.com
MINIO_BUCKET_NAME=vanroute-storage
MINIO_ACCESS_KEY=troque
MINIO_SECRET_KEY=troque-por-uma-senha-forte

# --- Quem pode chamar a API e abrir os WebSockets: o endereco do front ---
ALLOWED_ORIGINS=https://app.seu-dominio.com

# --- E-mail que manda os codigos ---
SENDER_EMAIL=seu.email@gmail.com
SENDER_PASSWORD=senha-de-app-do-gmail

# --- Mapas (OpenRouteService) ---
ORS_API_KEY=sua-chave

# --- Worker diario ---
WORKER_INTERVAL=24h
